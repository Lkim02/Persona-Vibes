{
  "manifest_version": 3,
  "name": "Twitter Activity Monitor",
  "version": "1.0.0",
  "description": "Monitors user tweets and replies on Twitter/X",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Twitter Activity Monitor"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "http://localhost:3000/*",
    "https://www.tiktok.com/*",
    "https://open.spotify.com/*",
    "https://openlibrary.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["tiktok-content.js"]
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-content.js"]
    },
    {
      "matches": ["https://openlibrary.org/*"],
      "js": ["book-content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
